---
import Base from '../layouts/Base.astro';
import {
  PHOTO3D_SHADER_URL,
  WALLPAPER_ATLAS,
  WALLPAPER_ATLAS_MOBILE,
} from '../io/runtime/macCanvas/apps';
import {
  portfolioArchiveProjects,
  portfolioCases,
  portfolioSideProjects,
  profile,
  videoClips,
} from '../io/data';
import type { PortfolioEvidence } from '../io/data';
import { webGpuProjects } from '../labs/webgpu/catalog';
import '../styles/io/macos.css';

const projectsById = (ids: string[]) => ids
  .map((id) => portfolioCases.en.find((project) => project.id === id))
  .filter((project): project is (typeof portfolioCases.en)[number] => Boolean(project));
const projectGroups = [
  { id: 'predy', title: 'Predy / RedNote', projects: projectsById(['predy-runtime', 'photo3d', 'predy-agent', 'production']) },
  { id: 'galacean', title: 'Galacean / Alipay', projects: projectsById(['galacean', 'alipay-products', 'xr']) },
];
const evidenceHref = (item: PortfolioEvidence) => {
  if (item.type === 'link') return item.href;
  if (item.type === 'video') return videoClips.en[item.clipIndex]?.src ?? '#';
  return `#app=${item.windowId}`;
};
---

<Base
  title="Sylvan Yu (俞宇锋) — Graphics / Rendering Engineer"
  description="Sylvan Yu (俞宇锋) is a graphics and visual systems engineer building real-time renderers, cross-platform runtimes, and editor tooling."
>
  <Fragment slot="head">
    <link rel="preload" href={WALLPAPER_ATLAS_MOBILE} as="image" type="image/webp" crossorigin="anonymous" fetchpriority="high" media="(max-width: 700px)" />
    <link rel="preload" href={WALLPAPER_ATLAS} as="image" type="image/webp" crossorigin="anonymous" fetchpriority="high" media="(min-width: 701px)" />
    <link rel="preload" href={PHOTO3D_SHADER_URL} as="fetch" crossorigin="anonymous" />
  </Fragment>

  <div class="mac-page" data-mac-single-canvas-root>
    <canvas
      class="mac-single-canvas"
      data-mac-single-canvas
      aria-label="Sylvan OS Photo3D wallpaper and liquid-glass background"
    ></canvas>
    <main class="mac-fallback" data-mac-fallback>
      <div class="mac-fallback__panel">
        <h1>Sylvan Yu / 俞宇锋</h1>
        <p class="mac-fallback__role">Graphics · Engines · Tools</p>
        <p class="mac-fallback__body">
          I build renderers—and the tools that make them usable. My work spans real-time motion engines, web editors, mobile runtimes, and WebGPU experiments.
        </p>
        <div class="mac-fallback__showcase">
          <a href="https://sylvanyu.io/webgpu-2d-gi/"><img src="/lab-covers/webgpu-2d-gi.png" alt="WebGPU 2D global illumination" /><strong>2D Global Illumination</strong></a>
          <a href="#app=photo3d"><img src={videoClips.en[0].poster} alt="Photo3D spatial photo" /><strong>Photo3D</strong></a>
          <a href="https://sylvanyu.io/y2k-type-lab/"><img src="/lab-covers/y2k-type-lab.webp" alt="Y2K Type Lab editor" /><strong>Y2K Type Lab</strong></a>
          <a href="https://github.com/sylvanyu-io/tab-recap"><img src="/lab-covers/tab-recap.jpg" alt="TabRecap browser side panel" /><strong>TabRecap</strong></a>
        </div>
        {projectGroups.map((group) => (
          <section class="mac-fallback__section" aria-labelledby={`mac-fallback-${group.id}`}>
            <h2 id={`mac-fallback-${group.id}`}>{group.title}</h2>
            <div class="mac-fallback__cases">
              {group.projects.map((project) => (
                <article>
                  <p class="mac-fallback__meta">{project.meta}</p>
                  <h3>{project.title}</h3>
                  <p>{project.lead}</p>
                  <ul>
                    {project.highlights.map((highlight) => <li>{highlight}</li>)}
                  </ul>
                  <div class="mac-fallback__inline-links">
                    {project.evidence.map((item) => (
                      <a href={evidenceHref(item)} rel="noreferrer">{item.label}</a>
                    ))}
                  </div>
                </article>
              ))}
            </div>
          </section>
        ))}
        <section class="mac-fallback__section" aria-labelledby="mac-fallback-independent">
          <h2 id="mac-fallback-independent">Independent</h2>
          <div class="mac-fallback__side-projects">
            {portfolioSideProjects.en.map((project) => (
              <article>
                {project.cover && <img src={project.cover} alt={project.coverAlt ?? ''} loading="lazy" />}
                <p class="mac-fallback__meta">{project.meta}</p>
                <h3>{project.title}</h3>
                <p>{project.description}</p>
                {project.details.map((detail) => <p>{detail}</p>)}
                <div class="mac-fallback__inline-links">
                  {project.evidence.map((item) => (
                    <a href={evidenceHref(item)} rel="noreferrer">{item.label}</a>
                  ))}
                </div>
                {project.labSlugs && (
                  <div class="mac-fallback__lab-links">
                    {project.labSlugs.map((slug) => {
                      const lab = webGpuProjects.find((entry) => entry.slug === slug);
                      return lab && <a href={lab.href}>{lab.title}</a>;
                    })}
                  </div>
                )}
              </article>
            ))}
          </div>
          <div class="mac-fallback__archive">
            {portfolioArchiveProjects.en.map((project) => (
              <a href={project.href} rel="noreferrer">
                <strong>{project.title}</strong>
                <span>{project.note}</span>
              </a>
            ))}
          </div>
        </section>
        <div class="mac-fallback__actions">
          <a href={`mailto:${profile.email}`}>{profile.email}</a>
          {profile.socials.map((social) => (
            <a href={social.href} rel="noreferrer">{social.label}</a>
          ))}
        </div>
      </div>
    </main>
  </div>

  <script>
    import { mountMacSingleCanvases } from '../io/runtime/macSingleCanvas';

    mountMacSingleCanvases();
  </script>
</Base>
