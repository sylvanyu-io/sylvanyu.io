---
import Base from '../layouts/Base.astro';
import {
  PHOTO3D_SHADER_URL,
  WALLPAPER_ATLAS,
  WALLPAPER_ATLAS_MOBILE,
} from '../io/runtime/macCanvas/apps';
import '../styles/io/macos.css';
---

<Base
  title="Sylvan Yu (俞宇锋) — Graphics / Rendering Engineer"
  description="Sylvan Yu (俞宇锋) is a graphics and visual systems engineer building real-time renderers, cross-platform runtimes, and editor tooling."
>
  <Fragment slot="head">
    <link rel="preload" href={WALLPAPER_ATLAS_MOBILE} as="image" type="image/webp" crossorigin="anonymous" fetchpriority="high" media="(max-width: 700px)" />
    <link rel="preload" href={WALLPAPER_ATLAS} as="image" type="image/webp" crossorigin="anonymous" fetchpriority="high" media="(min-width: 701px)" />
    <link rel="preload" href={PHOTO3D_SHADER_URL} as="fetch" crossorigin="anonymous" />
  </Fragment>

  <div class="mac-page" data-mac-single-canvas-root>
    <canvas
      class="mac-single-canvas"
      data-mac-single-canvas
      aria-label="Sylvan OS Photo3D wallpaper and liquid-glass background"
    ></canvas>
    <main class="mac-fallback" data-mac-fallback>
      <div class="mac-fallback__panel">
        <h1>Sylvan Yu / 俞宇锋</h1>
        <p class="mac-fallback__role">Graphics &amp; Engine Engineer · Shanghai</p>
        <p class="mac-fallback__body">
          I work on rendering systems and tools for interactive products, from motion runtimes and editors to mobile clients.
        </p>
        <section class="mac-fallback__section" aria-labelledby="mac-fallback-now">
          <h2 id="mac-fallback-now">Current role</h2>
          <p>
            <strong>Visual Systems Engineer, RedNote · 2025–present.</strong>
            I work on Predy and PlayKit, the company’s motion runtime and editor tooling, across Web, React Native, iOS, and Android.
          </p>
        </section>
        <section class="mac-fallback__section" aria-labelledby="mac-fallback-before">
          <h2 id="mac-fallback-before">Earlier</h2>
          <p>
            <strong>Graphics Engineer, Ant Group / Alipay · 2022–2025.</strong>
            I worked on the Galacean engine and its tooling, as well as rendering features and interactive graphics for Alipay products.
          </p>
        </section>
        <div class="mac-fallback__actions">
          <a href="https://github.com/sylvanyu-io" rel="noreferrer">GitHub</a>
          <a href="mailto:me@sylvanyu.io">Email</a>
        </div>
      </div>
    </main>
  </div>

  <script>
    import { mountMacSingleCanvases } from '../io/runtime/macSingleCanvas';

    mountMacSingleCanvases();
  </script>
</Base>
